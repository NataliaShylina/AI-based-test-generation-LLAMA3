      ],
      "expected_result": "Error message indicating missing credentials",
      "priority": "High",
      "test_type": "Negative"
    },
    {
      "id": "test_login_valid_username_invalid_course",
      "requirement": "User can browse available courses",
      "title": "Valid username with invalid course ID",
      "preconditions": "No previous login attempts",
      "steps": [
        "Enter valid username and invalid course ID",
        "Click the course link"
      ],
      "expected_result": "Error message indicating invalid course",
      "priority": "Medium",
      "test_type": "Boundary"
    },
    {
      "id": "test_login_invalid_username_valid_course",
      "requirement": "User can browse available courses",
