      "id": "TC1",
      "requirement": "User can log in to system",
      "title": "Successful Login",
      "preconditions": "No previous login attempts",
      "steps": [
        "Enter valid username and password",
        "Click the 'Log In' button"
      ],
      "expected_result": "System displays user dashboard",
      "priority": "High",
      "test_type": "Positive"
    },
    {
      "id": "TC2",
      "requirement": "System rejects invalid login",
